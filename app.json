{
  "expo": {
    "name": "Integrosaurus",
    "slug": "assign-integral",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "assign-integral",
    "icon": "./assets/images/app_icon_dino.png",
    "splash": {
      "image": "./assets/images/app_icon_dino.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F3EB"
    },
    "android": {
      "package": "com.assignintegral.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon_dino.png",
        "backgroundColor": "#F5F3EB"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.assignintegral.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#AEEE01"
        }
      ]
    ]
  }
}