{
  "expo": {
    "name": "Integrosaur",
    "slug": "assign-integral",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "assign-integral",
    "icon": "./assets/images/app_icon.jpg",
    "android": {
      "package": "com.assignintegral.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon.jpg",
        "backgroundColor": "#F5F3EB"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.assignintegral.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "backgroundColor": "#F5F3EB",
          "imageWidth": 1
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#AEEE01"
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "531e42bb-b159-4ad5-99fd-63d81facc67f"
      }
    }
  }
}
